<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.firetv-trim-caches</string>
  <key>ProgramArguments</key><array><string>/PATH/TO/firetvdebloate/tools/trim-caches.sh</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>FIRETV_IP</key><string>TV_IP</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/YOU/Library/Logs/firetv-trim-caches.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/firetv-trim-caches.log</string>
</dict></plist>
